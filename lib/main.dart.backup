// Camera Scanner Page (actual camera interface)
class _CameraScannerPage extends StatefulWidget {
  final Function(String) onQRCodeScanned;
  final bool isSuperAdmin;

  const _CameraScannerPage({
    required this.onQRCodeScanned,
    required this.isSuperAdmin,
  });

  @override
  _CameraScannerPageState createState() => _CameraScannerPageState();
}

class _CameraScannerPageState extends State<_CameraScannerPage> {
  final GlobalKey qrKey = GlobalKey(debugLabel: 'QR');
  QRViewController? controller;
  String? lastScannedCode;
  DateTime? lastScanTime;

  @override
  void initState() {
    super.initState();
  }

  @override
  void dispose() {
    controller?.dispose();
    super.dispose();
  }

  void _onQRViewCreated(QRViewController controller) {
    this.controller = controller;
    controller.scannedDataStream.listen((scanData) {
      if (scanData.code != null) {
        _handleQRCodeScan(scanData.code!);
      }
    });
  }

  void _handleQRCodeScan(String qrCode) {
    final now = DateTime.now();
    
    // Debounce: Ignore scans of the same code within 2 seconds
    if (lastScannedCode == qrCode && 
        lastScanTime != null && 
        now.difference(lastScanTime!).inSeconds < 2) {
      return;
    }
    
    // Update last scan info
    lastScannedCode = qrCode;
    lastScanTime = now;
    
    // Call the callback to pass the QR code back to the main page
    widget.onQRCodeScanned(qrCode);
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: Colors.black,
      appBar: AppBar(
        title: Text('Scanning'),
        backgroundColor: Colors.black,
        actions: [
          IconButton(
            icon: Icon(Icons.flash_on),
            onPressed: () async {
              await controller?.toggleFlash();
            },
          ),
          IconButton(
            icon: Icon(Icons.flip_camera_ios),
            onPressed: () async {
              await controller?.flipCamera();
            },
          ),
        ],
      ),
      body: Column(
        children: [
          Expanded(
            flex: 5,
            child: QRView(
              key: qrKey,
              onQRViewCreated: _onQRViewCreated,
            ),
          ),
          Expanded(
            flex: 1,
            child: Container(
              color: Colors.black,
              child: Center(
                child: Text(
                  'Point camera at QR code',
                  style: TextStyle(
                    fontSize: 16,
                    color: Colors.white,
                  ),
                ),
              ),
            ),
          ),
        ],
      ),
    );
  }
}

class ProfilePage extends StatefulWidget {
  const ProfilePage({super.key});

  @override
  _ProfilePageState createState() => _ProfilePageState();
}

class _ProfilePageState extends State<ProfilePage> {
    // Check if widget is still mounted
    if (!mounted) return;
    
    try {
      final isActive = data['isActive'];
      
      // Debug: Print the isActive value
      print('🔍 Monster Core isActive value: $isActive (type: ${isActive.runtimeType})');

      // First, check if core is active before doing anything else
      // Handle both boolean false and string "false"
      if (isActive == false || isActive == "false" || isActive == null) {
        showDialog(
          context: context,
          builder: (BuildContext context) {
            return AlertDialog(
              title: Text('Inactive Monster Core'),
              content: Column(
                mainAxisSize: MainAxisSize.min,
                children: [
                  Icon(Icons.warning, color: Colors.orange, size: 48),
                  SizedBox(height: 16),
                  Text(
                    'Please turn in core',
                    style: TextStyle(fontSize: 18, fontWeight: FontWeight.bold),
                  ),
                  SizedBox(height: 8),
                  Text('This Monster Core is no longer active.'),
                ],
              ),
              actions: [
                TextButton(
                  onPressed: () {
                    Navigator.of(context).pop();
                    _resetScanState();
                  },
                  child: Text('OK'),
                ),
              ],
            );
          },
        );
        return;
      }

      // Core is active - now parse all the data and track the scan
      final label = data['label'];
      final tier = data['tier'];
      final uniqueNumber = data['uniqueNumber'];
      final timestamp = data['timestamp'];
      final providedHash = data['verificationHash'];
      final coreId = data['id'];

      // Track the scan with location (don't await to avoid blocking UI)
      _trackMonsterCoreScan(data).catchError((error) {
        print('Error tracking scan: $error');
      });

      // Get current user's character data
      final user = _auth.currentUser;
      if (user == null) {
        _showError('User not authenticated');
        return;
      }

      // Get character data from Firebase Storage
      final email = user.email;
      if (email == null) {
        _showError('Email not available');
        return;
      }

      final ref = FirebaseStorage.instance.ref().child('users/$email/pc.json');
      final dataBytes = await ref.getData();
      if (dataBytes == null) {
        _showError('Character data not found');
        return;
      }

      final jsonString = utf8.decode(dataBytes);
      final characterData = json.decode(jsonString);
      final characterTier = characterData['cultivationTier'] ?? 'Iron';

      // Compare tiers
      final tierComparison = _compareTiers(characterTier, tier);
      
      // Show appropriate options based on tier comparison
      _showMonsterCoreOptions(data, tierComparison, characterData);

    } catch (e) {
      print('Error showing monster core QR result: $e');
      _showGenericQRResult(json.encode(data), 'Monster Core Data');
    }
  }

  int _compareTiers(String characterTier, String coreTier) {
    final tiers = ['Iron', 'Silver', 'Gold', 'Jade', 'Saint', 'Sovereign'];
    final characterIndex = tiers.indexOf(characterTier);
    final coreIndex = tiers.indexOf(coreTier);
    
    if (characterIndex == -1 || coreIndex == -1) return 0;
    
    return coreIndex - characterIndex; // Positive = core higher, negative = core lower
  }

  void _showMonsterCoreOptions(Map<String, dynamic> coreData, int tierDifference, Map<String, dynamic> characterData) {
    final coreTier = coreData['tier'];
    final characterTier = characterData['cultivationTier'] ?? 'Iron';
    
    String title;
    List<Widget> options = [];
    
    if (tierDifference == 0) {
      // Same tier
      title = 'Monster Core - Same Tier';
      options = [
        _buildConsumeOption(coreData, characterData, 'Consume for Build'),
        SizedBox(height: 12),
        _buildAffinityOption(coreData, characterData, 'Slot for Affinity Points'),
      ];
    } else if (tierDifference == -1) {
      // Core is 1 level lower
      title = 'Monster Core - Lower Tier';
      options = [
        Text('You need to scan 9 more active cores of $coreTier tier to equal 1 core.'),
        SizedBox(height: 16),
        ElevatedButton(
          onPressed: () {
            Navigator.of(context).pop(); // Close current dialog first
            _startLowerTierScanning(coreData, characterData);
          },
          child: Text('Start Scanning Lower Tier Cores'),
        ),
      ];
    } else if (tierDifference == 1) {
      // Core is 1 level higher
      title = 'Monster Core - Higher Tier';
      options = [
        _buildAffinityOption(coreData, characterData, 'Slot for Affinity Points (Perfect Cultivation)'),
      ];
    } else if (tierDifference == 2) {
      // Core is 2 levels higher
      title = 'Monster Core - Much Higher Tier';
      options = [
        ElevatedButton(
          onPressed: () => _resetBuild(coreData, characterData),
          child: Text('Reset Build'),
        ),
      ];
    } else {
      // Too big difference
      title = 'Monster Core - Tier Too Different';
      options = [
        Text('This core tier is too different from your cultivation tier.'),
      ];
    }

    showDialog(
      context: context,
      builder: (BuildContext context) {
        return AlertDialog(
          title: Text(title),
          content: Column(
            mainAxisSize: MainAxisSize.min,
            children: options,
          ),
          actions: [
            TextButton(
              onPressed: () {
                Navigator.of(context).pop();
                _resetScanState();
              },
              child: Text('Cancel'),
            ),
          ],
        );
      },
    );
  }

  Widget _buildConsumeOption(Map<String, dynamic> coreData, Map<String, dynamic> characterData, String title) {
    // TODO: Get current consumption count and max from event attendee type
    final currentConsumed = 0; // Get from database
    final maxConsume = 4; // Get from event attendee type
    
