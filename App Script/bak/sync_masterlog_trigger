/*******************************
 * SYNC MASTERLOG CALLER
 *******************************/
function callSyncMasterLog(idToken, options = {}) {
  try {
    const config = getSyncMasterLogConfig();
    
    // Merge options with defaults
    const params = {
      ...config.SYNC_DEFAULTS,
      ...options
    };
    
    console.log('Calling sync masterlog with params:', params);
    
    // Prepare the request
    const payload = {
      containerDocId: params.containerDocId,
      sheetName: params.sheetName,
      spreadsheetId: params.spreadsheetId
    };
    
    const requestOptions = {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': `Bearer ${idToken}`
      },
      payload: JSON.stringify(payload),
      muteHttpExceptions: true
    };
    
    // Make the HTTP request
    console.log('Making request to:', config.SYNC_MASTERLOG_URL);
    const response = UrlFetchApp.fetch(config.SYNC_MASTERLOG_URL, requestOptions);
    const responseCode = response.getResponseCode();
    const responseText = response.getContentText();
    
    console.log('Response code:', responseCode);
    console.log('Response text:', responseText);
    
    if (responseCode !== 200) {
      throw new Error(`HTTP ${responseCode}: ${responseText}`);
    }
    
    // Parse and return the response
    const result = JSON.parse(responseText);
    
    if (!result.ok) {
      throw new Error(`Sync failed: ${result.error || 'Unknown error'}`);
    }
    
    return {
      success: true,
      message: result.message,
      stats: {
        cleared: result.cleared,
        written: result.written,
        mirrored: result.mirrored,
        deletedFromCharacters: result.deletedFromCharacters,
        diagnostics: result.diagnostics
      },
      spreadsheetId: result.spreadsheetId,
      sheetName: result.sheetName,
      containerDocId: result.containerDocId
    };
    
  } catch (error) {
    console.error('Error calling sync masterlog:', error);
    throw error;
  }
}

/*******************************
 * CHARACTER CALCULATION FUNCTIONS
 *******************************/
function calculateCharacter(characterId, options = {}) {
  /**
   * Call the calculateCharacter Firebase function
   * 
   * @param {string} characterId - Character ID in format "{uid}_{characterNumber}" 
   * @param {object} options - Optional parameters
   * @param {boolean} options.debug - Enable debug mode (default: false)
   * @param {string} options.idToken - Optional manual ID token (uses service account if not provided)
   * @returns {object} Calculation results
   */
  
  try {
    const config = getSyncMasterLogConfig();
    
    // Get authentication token
    const idToken = options.idToken || getServiceAccountIdToken();
    if (!idToken) {
      throw new Error('Failed to get authentication token for calculateCharacter');
    }
    
    console.log(`Calculating character: ${characterId}`);
    
    // Prepare the request
    const payload = {
      characterId: characterId,
      debug: options.debug || false
    };
    
    const requestOptions = {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': `Bearer ${idToken}`
      },
      payload: JSON.stringify(payload),
      muteHttpExceptions: true
    };
    
    // Make the HTTP request
    const response = UrlFetchApp.fetch(config.CALCULATE_CHARACTER_URL, requestOptions);
    const responseCode = response.getResponseCode();
    const responseText = response.getContentText();
    
    console.log(`Calculate character response code: ${responseCode}`);
    
    if (responseCode !== 200) {
      // Enhanced error handling for common authentication/authorization issues
      let errorMessage = `Calculate character failed: HTTP ${responseCode}`;
      
      try {
        const errorResult = JSON.parse(responseText);
        if (errorResult.error) {
          switch (errorResult.error) {
            case 'Missing authorization header':
              errorMessage = 'Authentication failed: Missing authorization header. Check service account configuration.';
              break;
            case 'insufficient_permissions':
              errorMessage = `Permission denied: ${errorResult.message || 'Service account may not have super admin privileges'}`;
              break;
            case 'missing_target':
              errorMessage = `Invalid parameters: ${errorResult.message || 'Check characterId format'}`;
              break;
            default:
              errorMessage = `${errorResult.error}: ${errorResult.message || responseText}`;
          }
        }
      } catch (parseError) {
        errorMessage += ` - ${responseText}`;
      }
      
      throw new Error(errorMessage);
    }
    
    // Parse and return the response
    const result = JSON.parse(responseText);
    
    if (!result.ok) {
      throw new Error(`Calculate character failed: ${result.error || result.message || 'Unknown error'}`);
    }
    
    console.log(`✅ Character calculation completed for ${characterId}:`);
    console.log(`  - Advancement rows: ${result.advRows}`);
    console.log(`  - Affinities calculated: ${result.affinitiesCalculated}`);
    console.log(`  - Affinity count: ${result.affinityCount}`);
    
    return {
      success: true,
      characterId: characterId,
      uid: result.uid,
      characterNumber: result.characterNumber,
      advRows: result.advRows,
      detectedAffinityRows: result.detectedAffinityRows,
      affinitiesCalculated: result.affinitiesCalculated,
      affinityCount: result.affinityCount,
      detectedSkillRows: result.detectedSkillRows,
      debug: result.debug
    };
    
  } catch (error) {
    console.error(`Error calculating character ${characterId}:`, error);
    throw error;
  }
}

function calculateCharacterByParams(playerUid, characterNumber, options = {}) {
  /**
   * Call calculateCharacter using separate playerUid and characterNumber parameters
   * 
   * @param {string} playerUid - Player UID
   * @param {string} characterNumber - Character number
   * @param {object} options - Optional parameters
   * @returns {object} Calculation results
   */
  
  const characterId = `${playerUid}_${characterNumber}`;
  return calculateCharacter(characterId, options);
}

function calculateMultipleCharacters(characterIds, options = {}) {
  /**
   * Calculate multiple characters sequentially
   * 
   * @param {string[]} characterIds - Array of character IDs
   * @param {object} options - Optional parameters
   * @param {boolean} options.continueOnError - Continue if one character fails (default: true)
   * @param {number} options.delayMs - Delay between calculations in ms (default: 1000)
   * @returns {object} Results for all characters
   */
  
  const continueOnError = options.continueOnError !== false; // Default true
  const delayMs = options.delayMs || 1000; // Default 1 second delay
  
  const results = [];
  const errors = [];
  
  console.log(`Calculating ${characterIds.length} characters...`);
  
  for (let i = 0; i < characterIds.length; i++) {
    const characterId = characterIds[i];
    
    try {
      const result = calculateCharacter(characterId, options);
      results.push(result);
      console.log(`✅ Calculated ${characterId} (${i + 1}/${characterIds.length})`);
      
    } catch (error) {
      const errorInfo = {
        characterId: characterId,
        error: error.message,
        index: i
      };
      errors.push(errorInfo);
      console.error(`❌ Failed to calculate ${characterId}:`, error.message);
      
      if (!continueOnError) {
        throw new Error(`Failed to calculate character ${characterId}: ${error.message}`);
      }
    }
    
    // Add delay between requests to avoid rate limiting
    if (i < characterIds.length - 1 && delayMs > 0) {
      Utilities.sleep(delayMs);
    }
  }
  
  console.log(`Character calculations completed: ${results.length} successful, ${errors.length} failed`);
  
  return {
    success: errors.length === 0 || continueOnError,
    totalCharacters: characterIds.length,
    successfulCalculations: results.length,
    failedCalculations: errors.length,
    results: results,
    errors: errors
  };
}

/*******************************
 * FIREBASE SERVICE ACCOUNT AUTHENTICATION
 *******************************/
function getServiceAccountIdToken() {
  try {
    const config = getSyncMasterLogConfig();
    const serviceAccount = config.FIREBASE_SERVICE_ACCOUNT;
    
    if (!serviceAccount.CLIENT_EMAIL || !serviceAccount.PRIVATE_KEY) {
      throw new Error('Missing FIREBASE_CLIENT_EMAIL or FIREBASE_PRIVATE_KEY in script properties');
    }
    
    console.log('Getting service account token for:', serviceAccount.CLIENT_EMAIL);
    
    // Create JWT for Firebase Auth
    const now = Math.floor(Date.now() / 1000);
    const payload = {
      iss: serviceAccount.CLIENT_EMAIL,
      sub: serviceAccount.CLIENT_EMAIL,
      aud: 'https://identitytoolkit.googleapis.com/google.identity.identitytoolkit.v1.IdentityToolkit',
      iat: now,
      exp: now + 3600, // 1 hour
      uid: serviceAccount.CLIENT_EMAIL.replace('@', '_').replace('.', '_'), // Create a UID from email
      claims: {
        role: 'super_admin' // Ensure super admin role
      }
    };
    
    // Sign the JWT
    const jwt = createJWT(payload, serviceAccount.PRIVATE_KEY);
    
    // Exchange JWT for Firebase ID token
    const idToken = exchangeJWTForIdToken(jwt, serviceAccount.PROJECT_ID);
    
    return idToken;
    
  } catch (error) {
    console.error('Error getting service account ID token:', error);
    throw error;
  }
}

function createJWT(payload, privateKey) {
  try {
    // Create JWT header
    const header = {
      alg: 'RS256',
      typ: 'JWT'
    };
    
    // Encode header and payload
    const encodedHeader = Utilities.base64EncodeWebSafe(JSON.stringify(header)).replace(/=/g, '');
    const encodedPayload = Utilities.base64EncodeWebSafe(JSON.stringify(payload)).replace(/=/g, '');
    
    // Create signature
    const signatureInput = encodedHeader + '.' + encodedPayload;
    const signature = Utilities.computeRsaSha256Signature(signatureInput, privateKey);
    const encodedSignature = Utilities.base64EncodeWebSafe(signature).replace(/=/g, '');
    
    return signatureInput + '.' + encodedSignature;
    
  } catch (error) {
    console.error('Error creating JWT:', error);
    throw error;
  }
}

function exchangeJWTForIdToken(jwt, projectId) {
  try {
    // Use Firebase Auth REST API to get an ID token
    const url = `https://identitytoolkit.googleapis.com/v1/accounts:signInWithCustomToken?key=AIzaSyD6pJb56UjgUI2Pk5fFoHYTazY843Xciho`;
    
    const payload = {
      token: jwt,
      returnSecureToken: true
    };
    
    const options = {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      payload: JSON.stringify(payload),
      muteHttpExceptions: true
    };
    
    const response = UrlFetchApp.fetch(url, options);
    const responseCode = response.getResponseCode();
    const responseText = response.getContentText();
    
    if (responseCode !== 200) {
      throw new Error(`Failed to exchange JWT for ID token: ${responseCode} - ${responseText}`);
    }
    
    const result = JSON.parse(responseText);
    return result.idToken;
    
  } catch (error) {
    console.error('Error exchanging JWT for ID token:', error);
    throw error;
  }
}

