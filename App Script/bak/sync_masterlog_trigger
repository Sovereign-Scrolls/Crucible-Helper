function submitStagedToMasterLogsWithSyncSilent() {
  /**
   * Silent version without UI alerts - for automated/background use
   * Returns detailed results for programmatic handling
   */
  
  try {
    console.log('Starting silent staged data submission with sync...');
    
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const stagingSheet = ss.getSheetByName("PC Advancement Staging");
    const masterSheet = ss.getSheetByName("Master Logs");

    const startRow = 5;
    const lastRow = stagingSheet.getLastRow();
    const numRows = lastRow - startRow + 1;

    if (numRows < 1) {
      return { success: false, message: "No entries to submit", rowsMoved: 0 };
    }

    const dataRange = stagingSheet.getRange(startRow, 1, numRows, stagingSheet.getLastColumn());
    const data = dataRange.getValues();

    const rowsToSubmit = data.filter(row => row.some(cell => cell !== "")); // Skip blank rows

    if (rowsToSubmit.length === 0) {
      return { success: false, message: "No data to move (rows may be blank)", rowsMoved: 0 };
    }

    // Move the data
    masterSheet.getRange(masterSheet.getLastRow() + 1, 1, rowsToSubmit.length, rowsToSubmit[0].length).setValues(rowsToSubmit);
    dataRange.clearContent(); // Clear the submitted rows

    console.log(`Moved ${rowsToSubmit.length} rows to Master Logs`);

    // Upload JSON for each unique character
    const uniqueCharacters = [...new Set(rowsToSubmit.map(row => row[0]))];
    let jsonUploadErrors = 0;

    uniqueCharacters.forEach(characterNumber => {
      try {
        const jsonData = generateCharacterJsonFromLogs(characterNumber);
        const playerEmail = jsonData.playerEmail;
        const bucket = "crucible-helper.firebasestorage.app";
        const path = `users/${playerEmail}/pc.json`;

        uploadJsonToGCS(bucket, path, jsonData);
      } catch (error) {
        jsonUploadErrors++;
        console.error(`Failed to generate/upload JSON for character ${characterNumber}:`, error);
      }
    });

    console.log(`JSON uploads completed. Errors: ${jsonUploadErrors}/${uniqueCharacters.length}`);

    // Trigger sync to Firestore
    console.log('Triggering sync to Firestore...');
    const syncResult = triggerSyncMasterLog();
    console.log('Sync completed successfully');

    return {
      success: true,
      rowsMoved: rowsToSubmit.length,
      charactersAffected: uniqueCharacters.length,
      jsonUploadErrors,
      syncStats: syncResult.stats,
      message: `Successfully moved ${rowsToSubmit.length} rows and synced to Firestore`
    };

  } catch (error) {
    console.error('Error in submitStagedToMasterLogsWithSyncSilent:', error);
    return {
      success: false,
      error: error.message,
      message: `Error during submission/sync: ${error.message}`
    };
  }
}

