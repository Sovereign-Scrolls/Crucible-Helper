/*******************************
 * TOKEN VERIFICATION
 *******************************/
function _verifyIdTokenFlexible(idToken) {
  // 1) Google Sign-In on Web (GIS) — verify via tokeninfo
  if (CONFIG.WEB_CLIENT_ID) {
    const g = _verifyGoogleIdToken(idToken);
    if (g && !g.error && (g.iss === 'accounts.google.com' || g.iss === 'https://accounts.google.com')) {
      if (g.aud === CONFIG.WEB_CLIENT_ID && !_isExpired(g.exp)) {
        return {
          email: g.email,
          emailVerified: g.email_verified === true || g.email_verified === 'true'
        };
      }
    }
  }

  // 2) Firebase Auth Web — verify via Identity Toolkit
  if (CONFIG.FIREBASE && CONFIG.FIREBASE.API_KEY) {
    const f = _verifyFirebaseIdToken(idToken, CONFIG.FIREBASE.API_KEY);
    if (f && !f.error) {
      const u = f.users && f.users[0];
      if (u) {
        return {
          email: u.email,
          emailVerified: !!u.emailVerified
        };
      }
    }
  }

  return { error: 'Token not valid for configured client(s).' };
}

function _verifyGoogleIdToken(idToken) {
  // GET https://oauth2.googleapis.com/tokeninfo?id_token=XYZ
  try {
    const url = 'https://oauth2.googleapis.com/tokeninfo?id_token=' + encodeURIComponent(idToken);
    const res = UrlFetchApp.fetch(url, { muteHttpExceptions: true });
    if (res.getResponseCode() !== 200) {
      return { error: 'tokeninfo ' + res.getResponseCode() + ': ' + res.getContentText() };
    }
    return JSON.parse(res.getContentText());
  } catch (e) {
    return { error: String(e) };
  }
}

function _verifyFirebaseIdToken(idToken, apiKey) {
  // POST https://identitytoolkit.googleapis.com/v1/accounts:lookup?key=API_KEY  {"idToken":"..."}
  try {
    const url = 'https://identitytoolkit.googleapis.com/v1/accounts:lookup?key=' + encodeURIComponent(apiKey);
    const res = UrlFetchApp.fetch(url, {
      method: 'post',
      contentType: 'application/json',
      payload: JSON.stringify({ idToken }),
      muteHttpExceptions: true
    });
    if (res.getResponseCode() !== 200) {
      return { error: 'firebase ' + res.getResponseCode() + ': ' + res.getContentText() };
    }
    return JSON.parse(res.getContentText()); // { users: [ { email, emailVerified, ... } ] }
  } catch (e) {
    return { error: String(e) };
  }
}

/*******************************
 * SHEETS + UTIL
 *******************************/
function _getSpreadsheet() {
  const ss = SpreadsheetApp.getActiveSpreadsheet(); // container-bound
  if (ss) return ss;
  if (CONFIG.SPREADSHEET_ID) return SpreadsheetApp.openById(CONFIG.SPREADSHEET_ID);
  throw new Error('No container-bound spreadsheet. Bind the script or set CONFIG.SPREADSHEET_ID.');
}

function _appendRows(ss, sheetName, rows, expectedCols) {
  const sh = ss.getSheetByName(sheetName);
  if (!sh) throw new Error('Missing sheet/tab: ' + sheetName);
  const safeRows = rows.map(r => {
    if (r.length !== expectedCols) throw new Error(`Row for ${sheetName} had ${r.length} cols; expected ${expectedCols}`);
    return r;
  });
  const startRow = sh.getLastRow() + 1;
  sh.getRange(startRow, 1, safeRows.length, expectedCols).setValues(safeRows);
}

function _extractBearerToken(e) {
  const params = (e && e.parameter) ? e.parameter : {};
  if (params.authorization && /^Bearer\s+/i.test(params.authorization)) {
    return params.authorization.replace(/^Bearer\s+/i, '').trim();
  }
  return null;
}

function _asDate(ts) {
  const d = ts ? new Date(ts) : new Date();
  return isNaN(d.getTime()) ? new Date() : d;
}

function _isExpired(expSeconds) {
  if (!expSeconds) return false;
  return Math.floor(Date.now() / 1000) > Number(expSeconds);
}

/*******************************
 * RESPONSE HELPERS
 *******************************/
function _json(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj))
    .setMimeType(ContentService.MimeType.JSON);
}
function _badRequest(msg) { return _json({ ok: false, error: 'bad_request', message: msg }); }
function _unauthorized(msg){ return _json({ ok: false, error: 'unauthorized', message: msg }); }
function _serverError(msg){ return _json({ ok: false, error: 'server_error', message: msg }); }
